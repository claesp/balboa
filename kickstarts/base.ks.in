# Generated by Balboa. The selected disk will be erased.
@@MODE@@
lang @@LANGUAGE@@
keyboard --xlayouts=@@KEYBOARD@@
timezone @@TIMEZONE@@ --utc
@@SOURCE@@
network --bootproto=dhcp --device=link --activate --hostname=@@HOSTNAME@@
rootpw --lock
user --name=@@USERNAME@@ --groups=wheel --iscrypted --password=@@PASSWORD_HASH@@
sshkey --username=@@USERNAME@@ "@@SSH_PUBLIC_KEY@@"
authselect select local with-faillock
selinux --enforcing
firewall --enabled
services --enabled=auditd,chronyd,firewalld --disabled=sshd,kdump
firstboot --disable
bootloader --location=mbr --boot-drive=@@DISK@@ --iscrypted --password=@@BOOTLOADER_PASSWORD_HASH@@ --append="audit=1 audit_backlog_limit=8192 @@CONSOLE@@"
ignoredisk --only-use=@@DISK@@
zerombr
clearpart --all --initlabel --drives=@@DISK@@
reqpart --add-boot
part pv.01 --size=@@PV_MIB@@ --ondisk=@@DISK@@ --encrypted --luks-version=luks2@@PASSPHRASE@@
volgroup system pv.01
@@VOLUMES@@
@@DISPLAY@@
poweroff

%packages --excludedocs --exclude-weakdeps
@core --nodefaults
@@PACKAGES@@
audit
aide
authselect
chrony
cryptsetup
firewalld
openscap-scanner
scap-security-guide
python3
rsyslog
sudo
-telnet
-rsh
-tftp
%end

%post --interpreter=/bin/bash --erroronfail --log=/root/balboa-install.log
set -euo pipefail
umask 077
@@FILES@@
bash /usr/local/libexec/balboa/baseline.sh
systemctl enable balboa-harden.service balboa-audit.service
%end

%post --nochroot --interpreter=/bin/bash --erroronfail
if test -c /dev/ttyS0; then
    printf '\nBALBOA_INSTALL_COMPLETE\n' > /dev/ttyS0
fi
%end

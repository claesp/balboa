# Generated by Balboa. The selected disk will be erased.
@@MODE@@
lang @@LANGUAGE@@
keyboard --xlayouts=@@KEYBOARD@@
timezone @@TIMEZONE@@ --utc
@@SOURCE@@
network --bootproto=dhcp --device=link --activate --hostname=@@HOSTNAME@@
rootpw --lock
user --name=@@USERNAME@@ --groups=wheel --iscrypted --password=@@PASSWORD_HASH@@
sshkey --username=@@USERNAME@@ "@@SSH_PUBLIC_KEY@@"
authselect select local with-faillock
selinux --enforcing
firewall --enabled
services --enabled=auditd,chronyd,firewalld --disabled=sshd,kdump
firstboot --disable
bootloader --location=mbr --boot-drive=@@DISK@@ --iscrypted --password=@@BOOTLOADER_PASSWORD_HASH@@ --append="audit=1 audit_backlog_limit=8192 @@CONSOLE@@"
ignoredisk --only-use=@@DISK@@
zerombr
clearpart --all --initlabel --drives=@@DISK@@
reqpart --add-boot
part pv.01 --size=1 --grow --ondisk=@@DISK@@ --encrypted --luks-version=luks2@@PASSPHRASE@@
volgroup system pv.01
logvol / --vgname=system --name=root --fstype=xfs --size=16384 --grow
logvol /home --vgname=system --name=home --fstype=xfs --size=4096 --fsoptions="nodev,nosuid"
logvol /tmp --vgname=system --name=tmp --fstype=xfs --size=4096 --fsoptions="nodev,nosuid,noexec"
logvol /var --vgname=system --name=var --fstype=xfs --size=8192 --fsoptions="nodev,nosuid"
logvol /var/tmp --vgname=system --name=vartmp --fstype=xfs --size=4096 --fsoptions="nodev,nosuid,noexec"
logvol /var/log --vgname=system --name=log --fstype=xfs --size=4096 --fsoptions="nodev,nosuid,noexec"
logvol /var/log/audit --vgname=system --name=audit --fstype=xfs --size=2048 --fsoptions="nodev,nosuid,noexec"
logvol swap --vgname=system --name=swap --fstype=swap --size=2048
@@DISPLAY@@
poweroff

%packages --excludedocs
@@PACKAGES@@
audit
aide
authselect
chrony
cryptsetup
firewalld
openscap-scanner
scap-security-guide
python3
rsyslog
sudo
tmux
-telnet
-rsh
-tftp
%end

%post --interpreter=/bin/bash --erroronfail --log=/root/balboa-install.log
set -euo pipefail
umask 077
@@FILES@@
bash /usr/local/libexec/balboa/baseline.sh
systemctl enable balboa-harden.service balboa-audit.service
%end

%post --nochroot --interpreter=/bin/bash --erroronfail
if test -c /dev/ttyS0; then
    printf '\nBALBOA_INSTALL_COMPLETE\n' > /dev/ttyS0
fi
%end

Window.SetBackgroundTopColor(0.027, 0.071, 0.122);
Window.SetBackgroundBottomColor(0.027, 0.071, 0.122);
background_image = Image("boot.png");
spinner_image = Image("spinner.png");
entry_image = Image("entry.png");
background = Sprite();
spinner = Sprite();
entry = Sprite();
caption = Sprite();
mask = Sprite();
message = Sprite();
mode = "normal";
frame = 0;
width = 0;
height = 0;

fun text_at(sprite, text, y)
{
    if (text == "")
    {
        sprite.SetOpacity(0);
        return;
    }
    local.image = Image.Text(text, 241 / 255, 250 / 255, 251 / 255, 1, "Inter 16");
    if (local.image.GetWidth() > Window.GetWidth() * 0.9)
        local.image = local.image.Scale(Window.GetWidth() * 0.9,
            local.image.GetHeight() * Window.GetWidth() * 0.9 / local.image.GetWidth());
    sprite.SetImage(local.image);
    sprite.SetPosition(Window.GetX() + (Window.GetWidth() - local.image.GetWidth()) / 2,
                       Window.GetY() + y - local.image.GetHeight() / 2, 30);
    sprite.SetOpacity(1);
}

fun normal()
{
    global.mode = "normal";
    spinner.SetOpacity(1);
    entry.SetOpacity(0);
    caption.SetOpacity(0);
    mask.SetOpacity(0);
}

fun password(prompt, bullets)
{
    global.mode = "password";
    spinner.SetOpacity(0);
    entry.SetOpacity(1);
    text_at(caption, "Unlock the encrypted system disk", Window.GetHeight() * 0.59);
    local.visible = bullets;
    if (local.visible > 24)
        local.visible = 24;
    local.text = "";
    for (local.index = 0; local.index < local.visible; local.index++)
        local.text += "*";
    text_at(mask, local.text, Window.GetHeight() * 0.66);
}

fun layout()
{
    global.width = Window.GetWidth();
    global.height = Window.GetHeight();
    local.scale = width / background_image.GetWidth();
    if (height / background_image.GetHeight() > local.scale)
        local.scale = height / background_image.GetHeight();
    local.image = background_image.Scale(background_image.GetWidth() * local.scale,
                                          background_image.GetHeight() * local.scale);
    background.SetImage(local.image);
    background.SetPosition(Window.GetX() + (width - local.image.GetWidth()) / 2,
                           Window.GetY() + (height - local.image.GetHeight()) / 2, -10);
    local.entry_width = width * 0.45;
    if (local.entry_width > entry_image.GetWidth())
        local.entry_width = entry_image.GetWidth();
    entry.SetImage(entry_image.Scale(local.entry_width, entry_image.GetHeight()));
    entry.SetPosition(Window.GetX() + (width - local.entry_width) / 2,
                      Window.GetY() + height * 0.66 - entry_image.GetHeight() / 2, 20);
    local.spinner_size = height * 0.072;
    global.spinner_base = spinner_image.Scale(local.spinner_size, local.spinner_size);
}

fun refresh()
{
    if (width != Window.GetWidth() || height != Window.GetHeight())
        layout();
    if (mode == "password")
        return;
    global.frame++;
    if (frame >= 60)
        global.frame = 0;
    local.image = spinner_base.Rotate(6.283185 * frame / 60);
    spinner.SetImage(local.image);
    spinner.SetPosition(Window.GetX() + (width - local.image.GetWidth()) / 2,
                        Window.GetY() + height * 0.60 - local.image.GetHeight() / 2, 20);
}

fun display_message(text)
{
    text_at(message, text, Window.GetHeight() * 0.92);
}

fun hide_message(text)
{
    message.SetOpacity(0);
}

layout();
normal();
Plymouth.SetRefreshFunction(refresh);
Plymouth.SetDisplayNormalFunction(normal);
Plymouth.SetDisplayPasswordFunction(password);
Plymouth.SetDisplayMessageFunction(display_message);
Plymouth.SetHideMessageFunction(hide_message);
